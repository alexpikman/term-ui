$customPrompt = @'
function prompt {
    # Данные
    $ip = (Get-NetIPAddress -AddressFamily IPv4 | Where-Object { $_.InterfaceAlias -notmatch "Loopback" -and $_.IPAddress -ne "127.0.0.1" } | Select-Object -First 1).IPAddress
    if (-not $ip) { $ip = "127.0.0.1" }
    $time = Get-Date -Format "HH:mm:ss"
    $user = "$env:USERNAME@$env:COMPUTERNAME"
    $path = (Get-Location).Path
    
    # Цвета (ANSI)
    $e = [char]27
    $green  = "$e[32m"
    $yellow = "$e[33m"
    $cyan   = "$e[36m"
    $reset  = "$e[0m"

    # Формируем красивую разделительную линию (вся зеленая)
    $line = "$green" + "-" * 30 + "|$cyan $ip $green|$yellow $time $green|" + "-" * 30 + "$reset"

    # Сама строка приглашения (без лишних полосок)
    $promptLine = "$yellow ➜ $green$user$reset`:$cyan$path $yellow➜$reset "

    # Возвращаем результат (с пустыми строками для отступа)
    return "`n$line`n`n$promptLine"
}
'@

# Записываем в профиль
if (!(Test-Path -Path $PROFILE)) { New-Item -ItemType File -Path $PROFILE -Force | Out-Null }
# Очищаем старые попытки (на всякий случай), чтобы не дублировалось
Set-Content -Path $PROFILE -Value $customPrompt -Encoding UTF8

# Применяем
. $PROFILE


